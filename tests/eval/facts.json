      "mustContain": [
        "zdaln"
      ],
      "maxWords": 100,
      "language": "pl"
    }
  },
  {
    "id": "facts-03-languages-en",
    "prompt": "Which languages does he speak?",
    "uiLang": "en",
    "expect": {
      "mustContain": [
