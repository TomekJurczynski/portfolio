[
  {
    "id": "facts-01-remote-en",
    "prompt": "Does Tomasz work remotely?",
    "uiLang": "en",
    "expect": {
      "mustContain": [
        "remote"
      ],
      "mustMatchAny": [
        "prefers?",
        "strongly"
      ],
      "maxWords": 100,
      "language": "en"
    }
  },
  {
    "id": "facts-02-remote-pl",
    "prompt": "Czy Tomasz szuka pracy zdalnej, czy biurowej?",
    "uiLang": "pl",
