# Function secret — set in Netlify dashboard, never commit a real value here.
ANTHROPIC_API_KEY=

# Function config (optional, defaults shown in 02-SPEC-TECHNICZNA.md §7.4)
MODEL_ID=claude-haiku-4-5-20251001
MAX_OUTPUT_TOKENS=400
CHAT_ENABLED=true
ALLOWED_ORIGINS=

# Build-time (public) config
PUBLIC_SITE_URL=
PUBLIC_VOICE_PROVIDER=web-speech   # web-speech | cloud (needs /api/speak + TTS vendor key)
# Default look is Cosmos-dark / Baseline-light, set in BaseLayout.astro — not an
# env var anymore. PUBLIC_PALETTE_SWITCHER below is only a dev-only comparison
# tool for the non-default pairings (e.g. Cosmos-light), see Footer.astro.
PUBLIC_PALETTE_SWITCHER=false

# Cloud TTS (Google Chirp 3 HD) — /api/speak. Key restricted to the Cloud Text-to-Speech API only.
GOOGLE_TTS_API_KEY=
# Voice names (the part after "Chirp3-HD-"), e.g. Aoede, Kore, Puck — optional, defaults in lib/tts.ts
TTS_VOICE_EN=
TTS_VOICE_PL=
TTS_ENABLED=true

# TTS vendor for /api/speak: google (default, Chirp 3 HD) or elevenlabs
TTS_PROVIDER=google
# ElevenLabs — used when TTS_PROVIDER=elevenlabs. Voice ids (not names) from the ElevenLabs voice page.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_PL=
ELEVENLABS_VOICE_EN=
# Optional, default eleven_multilingual_v2 (e.g. eleven_flash_v2_5 for lower latency/price)
ELEVENLABS_MODEL=
