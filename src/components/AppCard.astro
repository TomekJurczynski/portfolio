---
import type { MarkdownSection } from '../content/loader';
import type { I18n } from '../i18n/types';

interface Screenshot {
  src: string;
  alt: string;
}

interface Props {
  id: string;
  name: string;
  summary: string;
  stack: string[];
  role: string;
  url: string;
  screenshots: Screenshot[];
  sections: MarkdownSection[];
  i18n: I18n;
}

const { id, name, summary, stack, role, url, screenshots, sections, i18n } = Astro.props;

// Variants are generated by scripts/optimize-images.mjs next to each source JPEG.
const webp = (src: string, width: number) => src.replace(/\.jpg$/, `-${width}.webp`);
---

<article id={`app-${id}`} class="app-card" tabindex="-1">
  <div class="screenshots" role="region" aria-label={`${name} — ${i18n.cta.screenshots}`} tabindex="0">
    {
      screenshots.map((s) => (
        <div class="screenshot-item">
          <picture>
            <source
              type="image/webp"
              srcset={`${webp(s.src, 360)} 360w, ${webp(s.src, 720)} 720w`}
              sizes="(min-width: 600px) 45vw, 70vw"
            />
            <img src={s.src} alt={s.alt} width="720" height="1529" loading="lazy" decoding="async" />
          </picture>
        </div>
      ))
    }
  </div>
  <div class="card-body">
    <h3>{name}</h3>
    <p class="summary">{summary}</p>
    <ul class="tag-list">
      {stack.map((item) => <li class="tag">{item}</li>)}
    </ul>
    <p class="role text-muted">{role}</p>
    <div class="card-actions">
      <a class="btn btn-primary" href={url} target="_blank" rel="noopener noreferrer">
        {i18n.cta.viewApp}
      </a>
      <button
        type="button"
        class="btn btn-secondary details-toggle"
        aria-expanded="false"
        aria-controls={`details-${id}`}
        data-label-show={i18n.cta.details}
        data-label-hide={i18n.cta.hideDetails}
      >
        {i18n.cta.details}
      </button>
    </div>
    <div id={`details-${id}`} class="details" hidden>
      {
        sections.map((s) => (
          <>
            <h4>{s.heading}</h4>
            <p>{s.text}</p>
          </>
        ))
      }
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('.details-toggle').forEach((button) => {
    const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
    if (!panel) return;
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!expanded));
      panel.hidden = expanded;
      button.textContent = expanded ? button.dataset.labelShow! : button.dataset.labelHide!;
    });
  });
</script>

<style>
  .app-card {
    background: var(--raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    outline-offset: 4px;
  }
  .app-card.highlight {
    outline: 2px solid var(--accent);
  }
  .screenshots {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: var(--space-2);
    /* Themed scrollbar instead of the OS-default gray/white bar, which clashed
       with the dark palettes. Firefox: */
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }
  /* Chrome/Edge/Safari: */
  .screenshots::-webkit-scrollbar {
    height: 6px;
  }
  .screenshots::-webkit-scrollbar-track {
    background: transparent;
  }
  .screenshots::-webkit-scrollbar-thumb {
    background-color: var(--border-strong);
    border-radius: 999px;
  }
  .screenshots::-webkit-scrollbar-thumb:hover {
    background-color: var(--accent);
  }
  .screenshot-item {
    flex: 0 0 70%;
    aspect-ratio: 9 / 19;
    border-radius: var(--radius-control);
    overflow: hidden;
    scroll-snap-align: start;
    background: var(--surface);
  }
  .screenshot-item picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .screenshot-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .card-body {
    padding: var(--space-4) var(--space-5) var(--space-5);
  }
  .card-body h3 {
    margin: 0 0 var(--space-2);
  }
  .summary {
    margin: 0 0 var(--space-3);
  }
  .role {
    margin: var(--space-3) 0 0;
  }
  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .details {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .details h4 {
    margin: var(--space-3) 0 var(--space-1);
  }
  .details h4:first-child {
    margin-top: 0;
  }

  @media (min-width: 600px) {
    .screenshot-item {
      flex-basis: 45%;
    }
  }
</style>
