---
// Full-width project card (layouts `featured` / `workflow`): a 3-column row where the text
// spans two columns and the image takes the third. Collapsed it shows the summary, stack and
// first image; "Details" expands the full write-up (same toggle as the phone cards, so
// openApp() and the chat's {{nav:app-<id>}} work unchanged).
import type { MarkdownSection } from '../content/loader';
import type { I18n } from '../i18n/types';

interface Image {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

interface Props {
  id: string;
  name: string;
  summary: string;
  stack: string[];
  role: string;
  url?: string | undefined;
  screenshots: Image[];
  sections: MarkdownSection[];
  i18n: I18n;
}

const { id, name, summary, stack, role, url, screenshots, sections, i18n } = Astro.props;

// Variants are generated by scripts/optimize-images.mjs next to each source JPEG.
const webp = (src: string, width: number) => src.replace(/\.jpg$/, `-${width}.webp`);
// scripts/optimize-images.mjs only emits widths up to the source width.
const WIDTHS = [360, 720, 1120];
const srcset = (src: string, sourceWidth: number) =>
  WIDTHS.filter((w) => w <= sourceWidth)
    .map((w) => `${webp(src, w)} ${w}w`)
    .join(', ');
---

<article id={`app-${id}`} class="featured-card" tabindex="-1">
  <div class="featured-text">
    <h3>{name}</h3>
    <p class="summary">{summary}</p>
    <ul class="tag-list">
      {stack.map((item) => <li class="tag">{item}</li>)}
    </ul>
    <p class="role text-muted">{role}</p>
    <div class="card-actions">
      {
        url && (
          <a class="btn btn-primary" href={url} target="_blank" rel="noopener noreferrer">
            {i18n.cta.viewApp}
          </a>
        )
      }
      <button
        type="button"
        class="btn btn-secondary details-toggle"
        aria-expanded="false"
        aria-controls={`details-${id}`}
        data-label-show={i18n.cta.details}
        data-label-hide={i18n.cta.hideDetails}
      >
        {i18n.cta.details}
      </button>
    </div>
    <div id={`details-${id}`} class="details sections" hidden>
      {
        sections.map((s) => (
          <section>
            <h4>{s.heading}</h4>
            <p>{s.text}</p>
          </section>
        ))
      }
    </div>
  </div>
  <div class="featured-media">
    {
      screenshots.map((s, index) => (
        <button
          type="button"
          class:list={['media-link', { 'media-extra': index > 0 }]}
          data-lightbox={s.src}
          data-lightbox-alt={s.alt}
          aria-haspopup="dialog"
          aria-label={`${i18n.cta.openImage}: ${s.alt}`}
        >
          <picture>
            <source type="image/webp" srcset={srcset(s.src, s.width ?? 1129)} sizes="(min-width: 900px) 30vw, 90vw" />
            <img
              src={s.src}
              alt=""
              width={s.width ?? 1129}
              height={s.height ?? 673}
              loading="lazy"
              decoding="async"
            />
          </picture>
        </button>
      ))
    }
  </div>
</article>

<script>
  import '../scripts/detailsToggle';
</script>

<style>
  .featured-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    background: var(--raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    outline-offset: 4px;
  }
  .featured-card.highlight {
    outline: 2px solid var(--accent);
  }
  h3 {
    margin: 0 0 var(--space-2);
  }
  .summary {
    margin: 0 0 var(--space-3);
  }
  .role {
    margin: var(--space-3) 0 0;
  }
  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .details {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .sections:not([hidden]) {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  .sections h4 {
    margin: 0 0 var(--space-1);
  }
  .sections p {
    margin: 0;
  }
  .featured-media {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-self: start;
    /* Phones: picture first, then the write-up. */
    order: -1;
  }
  .media-link {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    overflow: hidden;
    background: var(--surface);
    cursor: zoom-in;
  }
  .media-link:hover {
    border-color: var(--accent);
  }
  .media-link img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Collapsed: only the first image; the rest appear with the write-up. */
  .featured-card:has(.details-toggle[aria-expanded='false']) .media-extra {
    display: none;
  }

  @media (min-width: 900px) {
    .featured-card {
      grid-template-columns: repeat(3, 1fr);
    }
    .featured-text {
      grid-column: span 2;
    }
    .featured-media {
      order: 0;
      /* Stays beside the long write-up while it scrolls (header is ~64px tall). */
      position: sticky;
      top: 88px;
    }
    .sections:not([hidden]) {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
