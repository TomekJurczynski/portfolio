---
import { parseSections, type ProjectEntry } from '../content/loader';
import type { I18n } from '../i18n/types';
import AppCard from './AppCard.astro';
import FeaturedCard from './FeaturedCard.astro';
import Lightbox from './Lightbox.astro';

interface Props {
  i18n: I18n;
  projects: ProjectEntry[];
}

const { i18n, projects } = Astro.props;

// Rows top to bottom: featured (this site) → phone apps (3-up grid) → workflow (n8n).
const byLayout = (layout: string) => projects.filter((p) => p.frontmatter.layout === layout);
const featured = byLayout('featured');
const mobile = byLayout('mobile');
const workflows = byLayout('workflow');
---

<section id="apps" class="apps">
  <div class="container">
    <h2>{i18n.nav.apps}</h2>
    {
      featured.length > 0 && (
        <div class="apps-stack">
          {featured.map((p) => (
            <FeaturedCard
              id={p.frontmatter.id}
              name={p.frontmatter.name}
              summary={p.frontmatter.summary}
              stack={p.frontmatter.stack}
              role={p.frontmatter.role}
              url={p.frontmatter.url}
              screenshots={p.frontmatter.screenshots}
              sections={parseSections(p.body)}
              i18n={i18n}
            />
          ))}
        </div>
      )
    }
    <div class="apps-grid">
      {
        mobile.map((p) => (
          <AppCard
            id={p.frontmatter.id}
            name={p.frontmatter.name}
            summary={p.frontmatter.summary}
            stack={p.frontmatter.stack}
            role={p.frontmatter.role}
            url={p.frontmatter.url!}
            screenshots={p.frontmatter.screenshots}
            sections={parseSections(p.body)}
            i18n={i18n}
          />
        ))
      }
    </div>
    {
      workflows.length > 0 && (
        <div class="apps-stack">
          {workflows.map((p) => (
            <FeaturedCard
              id={p.frontmatter.id}
              name={p.frontmatter.name}
              summary={p.frontmatter.summary}
              stack={p.frontmatter.stack}
              role={p.frontmatter.role}
              url={p.frontmatter.url}
              screenshots={p.frontmatter.screenshots}
              sections={parseSections(p.body)}
              i18n={i18n}
            />
          ))}
        </div>
      )
    }
  </div>
  <Lightbox i18n={i18n} />
</section>

<script>
  // Deep-link support: #app-<id> on load expands that card's details, scrolls it
  // into view, and briefly highlights it — via the shared openApp helper, the
  // same one the chat widget's {{nav:app-<id>}} actions call.
  import { openApp } from '../scripts/nav';

  const hash = location.hash;
  if (hash.startsWith('#app-')) {
    openApp(hash.slice('#app-'.length));
  }
</script>

<style>
  .apps {
    padding-block: var(--space-7);
  }
  .apps-stack {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }
  .apps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  @media (min-width: 600px) {
    .apps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1200px) {
    .apps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
