---
// One shared full-image viewer for every `[data-lightbox]` button on the page. A native modal
// <dialog>: focus is trapped and restored to the button, Esc closes it, and the scroll position
// never changes. Clicking anywhere outside the image (the dimmed backdrop) closes it too.
import type { I18n } from '../i18n/types';

interface Props {
  i18n: I18n;
}
const { i18n } = Astro.props;
---

<dialog class="lightbox" id="lightbox" aria-label={i18n.cta.openImage}>
  <button type="button" class="lightbox-close" aria-label={i18n.cta.closeImage}>×</button>
  <img class="lightbox-img" alt="" />
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const image = dialog?.querySelector<HTMLImageElement>('.lightbox-img');
  if (dialog && image) {
    document.addEventListener('click', (event) => {
      const trigger = (event.target as Element).closest<HTMLElement>('[data-lightbox]');
      if (!trigger) return;
      image.src = trigger.dataset.lightbox ?? '';
      image.alt = trigger.dataset.lightboxAlt ?? '';
      dialog.showModal();
    });
    // The dialog fills the viewport, so a click that lands on the dialog itself (not on the
    // image or the close button) is a click outside the picture.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || (event.target as Element).closest('.lightbox-close')) dialog.close();
    });
    dialog.addEventListener('close', () => image.removeAttribute('src'));
  }
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: var(--space-5);
    border: 0;
    background: transparent;
    color: var(--text);
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
  }
  .lightbox[open] {
    display: flex;
  }
  .lightbox::backdrop {
    background: rgba(5, 8, 14, 0.72);
    backdrop-filter: blur(3px);
  }
  .lightbox-img {
    display: block;
    max-width: min(92vw, 1400px);
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-control);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    background: var(--surface);
    cursor: default;
  }
  .lightbox-close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-4);
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--raised);
    color: var(--text);
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox-close:hover {
    border-color: var(--accent);
  }
  :global(body:has(.lightbox[open])) {
    overflow: hidden;
  }
</style>
