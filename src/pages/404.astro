---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSite } from '../content/loader';

const site = loadSite();
---

<BaseLayout
  lang="en"
  enPath="/404/"
  plPath="/404/"
  title={`Page not found — ${site.ownerName}`}
  description="Page not found."
  siteUrl={site.siteUrl}
  email={site.email}
>
  <main id="main" class="container page-section-notfound">
    <h1>Page not found</h1>
    <p class="text-muted">The page you're looking for doesn't exist.</p>
    <p>
      <a class="btn btn-primary" href="/">Back to the homepage</a>
      <a class="btn btn-secondary" href="/pl/">Strona główna (PL)</a>
    </p>
  </main>
</BaseLayout>
