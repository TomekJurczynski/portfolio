---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadSite } from '../content/loader';
import en from '../i18n/en.json';

const site = loadSite();
const showPaletteSwitcher = import.meta.env.PUBLIC_PALETTE_SWITCHER === 'true';
---

<BaseLayout
  lang="en"
  enPath="/privacy/"
  plPath="/pl/privacy/"
  title={`Privacy — ${site.ownerName}`}
  description="What this site does and does not collect."
  siteUrl={site.siteUrl}
  email={site.email}
>
  <Header ownerName={site.ownerName} i18n={en} otherLangHref="/pl/privacy/" />
  <main id="main">
    <section class="container page-section">
      <h1>Privacy</h1>
      <p>
        This site does not use tracking cookies and does not store any visitor or recruiter data on
        a server. <code>localStorage</code> keeps your language, color theme and palette preference,
        entirely in your browser. <code>sessionStorage</code> keeps your chat conversation for as
        long as the browser tab stays open — it clears when you close the tab and is never read back
        by us afterwards.
      </p>
      <p>
        The host (Netlify) may keep standard technical logs, including IP addresses, as part of
        serving the site; this project does not add any logging of its own on top of that.
      </p>
      <p>
        This site has an AI chat assistant. Messages you send it are processed by Anthropic's Claude
        API to generate a reply — only the message text and recent conversation history are sent, no
        other personal data.
      </p>
      <p>
        Voice is optional. If you tap the microphone, speech recognition is performed by your
        browser, and depending on the browser (for example Chrome and Edge) your audio may be sent
        to the browser vendor's speech service — this site never receives or stores the audio, only
        the transcribed text that you then send like any other message. The microphone button also
        reads the input level locally to animate itself; that audio is not recorded or sent
        anywhere. Firefox has no speech recognition, so the microphone button is hidden there.
      </p>
      <p>
        Reading a reply aloud (automatically after a spoken question, or when you tap the speaker
        icon) sends the text of that reply through this site's server to a text-to-speech provider
        (currently ElevenLabs), which returns the audio. Only the reply text is sent — not your
        question and no other personal data — and this site does not store it. The provider
        processes it under its own privacy policy. If the voice service is unavailable, the reply
        is read with your browser's built-in speech synthesis on your device instead.
      </p>
    </section>
  </main>
  <Footer i18n={en} privacyHref="/privacy/" showPaletteSwitcher={showPaletteSwitcher} />
</BaseLayout>
